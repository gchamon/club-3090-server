[Unit]
Description=Club-3090 headless Xorg for NVIDIA fan control
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=-@ENV_FILE@
ExecStart=@SOURCE_ROOT@/scripts/prepare-headless-x.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
