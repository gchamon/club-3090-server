[Unit]
Description=Club-3090 Server model scores benchmark worker
After=network-online.target docker.service club3090-control.service
Wants=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=-@ENV_FILE@
WorkingDirectory=@SOURCE_ROOT@/src
ExecStart=/usr/bin/python3 -m control.http_server --benchmark-worker
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
